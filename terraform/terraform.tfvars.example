# Copy this file to terraform.tfvars and adjust if needed.
# terraform.tfvars is gitignored since it may end up with account-specific
# overrides; the defaults below already match variables.tf.

project_name = "globaltest"
environment  = "dev"

regions = {
  uk        = "eu-west-2"
  us        = "us-east-1"
  germany   = "eu-central-1"
  australia = "ap-southeast-2"
  ireland   = "eu-west-1"
  india     = "ap-south-1"
  brazil    = "sa-east-1"
}

vpc_cidrs = {
  uk        = "10.10.0.0/16"
  us        = "10.20.0.0/16"
  germany   = "10.30.0.0/16"
  australia = "10.40.0.0/16"
  ireland   = "10.50.0.0/16"
  india     = "10.70.0.0/16"
  brazil    = "10.80.0.0/16"
}

tags = {
  Project   = "globaltest"
  ManagedBy = "terraform"
}
